<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知：Android 13（API 33）起是运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 提醒震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 开机后恢复提醒计划 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      精确闹钟：Android 12（API 31）起需要声明，Android 14 起默认不授予，
      用户可在“闹钟和提醒”中单独授权；未授权时代码会自动降级为非精确闹钟。
      本项目不使用 USE_EXACT_ALARM（那是闹钟类 App 才能用的权限）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 注意：没有 INTERNET 权限 —— 本 App 完全离线，不做任何联网行为 -->

    <application
        android:name=".SitDrinkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SitDrink">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ReminderSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 闹钟到点后由它发通知并排下一次提醒；只接收自己 App 的 PendingIntent -->
        <receiver
            android:name=".alarm.ReminderReceiver"
            android:exported="false" />

        <!--
          开机 / 覆盖安装 / 改系统时间 / 时区变化 / 精确闹钟权限变化时，
          重新计算并注册提醒。上面这些广播都是系统受保护广播，
          第三方 App 无法伪造，因此 exported=true 是安全的。
        -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
