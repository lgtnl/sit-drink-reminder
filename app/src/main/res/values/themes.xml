<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      浅色主题：使用平台 Material 主题（NoActionBar），不依赖 appcompat / MDC。
      深色模式在 values-night/themes.xml 里用 Theme.Material（深色）覆盖。
    -->
    <style name="Theme.SitDrink" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
